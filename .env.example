# OpenAI-compatible chat-completions endpoint and key for the "default" provider in models.json.
# Copy to .env and fill in. Never commit .env.
# LLM_API_BASE: base URL up to /v1 (the code adds /chat/completions), e.g. https://api.openai.com/v1 or
#               http://localhost:8000/v1 for a vLLM server.
# LLM_API_KEY:  API key for that endpoint (any string if the server does not check keys).
# Used by the agent runs and by fill/llm_fill.py.
LLM_API_BASE=
LLM_API_KEY=
# More providers: add an entry to "providers" in models.json naming its two variables, e.g.
# OTHER_API_BASE=
# OTHER_API_KEY=
