+def _forced_reasoning_echo(agent) -> bool:
+    """PATCH: for models matching HERMES_ECHO_REASONING_MODELS="gpt-oss,...", send the previous assistant turns'
+    reasoning back unchanged (the hermes 0.14 default). 0.19 strips this field for all but DeepSeek/Kimi/MiMo,
+    and gpt-oss (harmony) served by vLLM then produced many more broken tool names, empty responses and
+    truncations once the previous turns' analysis channel was missing."""
+    import os as _os
+    pats = [p.strip().lower() for p in (_os.environ.get("HERMES_ECHO_REASONING_MODELS") or "").split(",") if p.strip()]
+    if not pats:
+        return False
+    model = (getattr(agent, "model", "") or "").lower()
+    return any(p in model for p in pats)
